// DGT.LZ Gateway Ã¢â‚¬â€ Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum KeyStatus {
  ACTIVE
  REVOKED
  DELETED
}

enum BillingStatus {
  // MVP: metering only, no payments. TRACKED = usage recorded & costed.
  TRACKED
  UNPRICED // model had no pricing row - cost is unknown, never fabricated
  ALLOWANCE // paid for with converted credit balance (allowance tokens)
}

enum RequestStatus {
  SUCCESS
  PROVIDER_ERROR
  AUTH_ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
  CLIENT_ERROR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  apiKeys      ApiKey[]
  usageQuota   UsageQuota?
  requestLogs  RequestLog[]
  usageRecords UsageRecord[]
  agents       Agent[]
  credits      CreditLedgerEntry[]
  adSessions   AdSession[]

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  name         String
  keyHash      String    @unique // HMAC-SHA256 of full key
  prefix       String // masked display prefix, e.g. dgtlz_live_ab12cd34
  status       KeyStatus @default(ACTIVE)
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])

  requestLogs  RequestLog[]
  usageRecords UsageRecord[]

  @@index([userId, status])
}

model Provider {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "openagentic", "mock"
  name      String
  baseUrl   String
  status    String   @default("active") // active | disabled | degraded
  createdAt DateTime @default(now())

  models      Model[]
  requestLogs RequestLog[]
}

model Model {
  id              String  @id @default(cuid())
  providerId      String
  providerModelId String // upstream model identifier
  displayName     String
  contextWindow   Int?
  available       Boolean @default(true)

  provider Provider       @relation(fields: [providerId], references: [id])
  pricing  ModelPricing[]

  @@unique([providerId, providerModelId])
}

model RequestLog {
  id         String        @id @default(cuid())
  requestId  String        @unique // idempotency key for usage recording
  userId     String
  apiKeyId   String?
  providerId String
  model      String
  endpoint   String
  status     RequestStatus
  httpStatus Int
  latencyMs  Int
  createdAt  DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id])
  apiKey      ApiKey?      @relation(fields: [apiKeyId], references: [id])
  provider    Provider     @relation(fields: [providerId], references: [id])
  usageRecord UsageRecord?

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model UsageRecord {
  id            String        @id @default(cuid())
  requestId     String        @unique // FK to RequestLog.requestId Ã¢â‚¬â€ enforces idempotency
  userId        String
  apiKeyId      String?
  provider      String
  model         String
  inputTokens   Int? // null = provider did not report; never fabricated
  outputTokens  Int?
  totalTokens   Int?
  latencyMs     Int
  estimatedCost Decimal?      @db.Decimal(12, 6) // upstream cost, null when unpriced
  billingStatus BillingStatus @default(TRACKED)
  recordedAt    DateTime      @default(now())

  requestLog RequestLog @relation(fields: [requestId], references: [requestId])
  user       User       @relation(fields: [userId], references: [id])
  apiKey     ApiKey?    @relation(fields: [apiKeyId], references: [id])

  @@index([userId, recordedAt])
  @@index([model, recordedAt])
}

model ModelPricing {
  id            String    @id @default(cuid())
  modelId       String
  model         String // upstream model id (denormalized for lookup)
  providerSlug  String
  inputPer1M    Decimal   @db.Decimal(12, 6) // USD per 1M input tokens
  outputPer1M   Decimal   @db.Decimal(12, 6)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = current
  modelRef      Model     @relation(fields: [modelId], references: [id])

  @@unique([providerSlug, model, effectiveFrom])
  @@index([model, effectiveFrom])
}

model UsageQuota {
  id             String   @id @default(cuid())
  userId         String   @unique
  requestsPerDay Int      @default(1000)
  tokensPerDay   Int      @default(1000000)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // admin or user id, null for system
  action    String // e.g. "key.revoked", "user.suspended"
  target    String? // entity description
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
}

// Ã¢â€â‚¬Ã¢â€â‚¬ Agents: user-facing task runner Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
// A user (or operator) deploys an Agent: a named list of prompts executed
// sequentially through the gateway provider. Progress is tracked per step so
// the dashboard can poll live status.
enum AgentStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentRunBy {
  USER
  OPERATOR
}

model Agent {
  id          String      @id @default(cuid())
  userId      String // owner (operator-deployed agents are owned by the target user)
  name        String
  model       String
  status      AgentStatus @default(QUEUED)
  runBy       AgentRunBy  @default(USER)
  totalTokens Int         @default(0)
  error       String?
  createdAt   DateTime    @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  user  User       @relation(fields: [userId], references: [id])
  steps AgentStep[]

  @@index([userId, createdAt])
  @@index([status])
}

model AgentStep {
  id        String   @id @default(cuid())
  agentId   String
  index     Int // 0-based execution order
  prompt    String
  status    AgentStatus @default(QUEUED)
  result    String? // assistant content (truncated for storage)
  tokens    Int      @default(0)
  latencyMs Int?
  error     String?
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, index])
}

// ===========================================================================
// Credits, ads ("watch to earn") and top-ups.
//
// LEDGER RULE: every balance movement is one immutable row in
// CreditLedgerEntry. `balanceAfter` is written in the same transaction as the
// row, so the newest row alone tells you the balance and the whole table is an
// audit trail. Rows are never updated or deleted â€” corrections are new rows.
//
// All money is stored in WHOLE RUPIAH (Int). Ads pay Rp 700-5.000 per view,
// conversions trade rupiah balance for an allowance-token pool.
// ===========================================================================

enum CreditEntryType {
  AD_REWARD // watched a creative to completion
  TOPUP // purchased balance (payment webhook)
  GRANT // operator goodwill / promo
  ADJUSTMENT // operator correction
  CONVERT // balance -> allowance tokens (negative amount)
  REFUND // reversal of a CONVERT
}

enum CreditSource {
  HOUSE // our own creative, no sponsor revenue attached
  SPONSOR // real sponsored creative
  OPERATOR // issued from the operator console
  PAYMENT // purchased
}

enum AdSessionStatus {
  ISSUED // nonce minted, clip not finished yet
  COMPLETED // finished within tolerance, reward paid
  REJECTED // guard failed: too fast / tabbed away / replayed
  EXPIRED // never finished before the deadline
}

model CreditLedgerEntry {
  id            String          @id @default(cuid())
  userId        String
  type          CreditEntryType
  source        CreditSource
  /// Whole rupiah. Positive credits the balance, negative debits it.
  amountRupiah  Int
  /// Balance right after this entry, in whole rupiah.
  balanceAfter  Int
  /// CONVERT rows only: allowance tokens granted by this conversion.
  tokensGranted BigInt?
  /// AD_REWARD rows only: the ad session that paid this out.
  adSessionId   String?         @unique
  note          String?
  actorId       String? // "operator" | "system" | user id
  createdAt     DateTime        @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adSession AdSession? @relation(fields: [adSessionId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
}

model AdCreative {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  brand           String
  tagline         String?
  videoUrl        String
  posterUrl       String?
  accent          String       @default("#67dcf2")
  durationMs      Int          @default(7000)
  source          CreditSource @default(HOUSE)
  sourceUrl       String? // attribution for the stock footage
  license         String?
  rewardMinRupiah Int          @default(700)
  rewardMaxRupiah Int          @default(5000)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())

  sessions AdSession[]

  @@index([active])
}

model AdSession {
  id            String          @id @default(cuid())
  userId        String
  creativeId    String
  /// HMAC(secret, id|userId|issuedAt) â€” binds the reward to this user.
  nonce         String          @unique
  status        AdSessionStatus @default(ISSUED)
  /// Randomised at issue time so the client cannot pick its own payout.
  rewardRupiah  Int
  durationMs    Int
  /// Times the tab lost focus during playback, reported by the client.
  interruptions Int             @default(0)
  /// How long the clip actually played, in ms, as reported by the client.
  watchedMs     Int             @default(0)
  ip            String?
  userAgent     String?
  issuedAt      DateTime        @default(now())
  expiresAt     DateTime
  completedAt   DateTime?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  creative AdCreative         @relation(fields: [creativeId], references: [id])
  ledger   CreditLedgerEntry?

  @@index([userId, issuedAt])
  @@index([status])
}

/// One row, id = "singleton". Every knob is operator-editable at runtime.
model CreditConfig {
  id                    String   @id @default("singleton")
  /// Allowance tokens granted per 1 rupiah of converted balance.
  tokensPerRupiah       Int      @default(50)
  /// Minimum unconverted balance (rupiah) before a conversion is allowed.
  minConvertRupiah      Int      @default(10000)
  /// Ads a single user may complete per calendar day.
  dailyAdsPerUser       Int      @default(15)
  /// Maximum rupiah a user may earn from ads per calendar day.
  dailyRewardCapRupiah  Int      @default(60000)
  /// Allowance tokens a user may convert per rolling week.
  weeklyTokenCap        BigInt   @default(5000000)
  /// Percent of the clip that must be watched before a reward is paid.
  minWatchPercent       Int      @default(85)
  /// Seconds an issued session stays valid.
  sessionTtlSeconds     Int      @default(300)
  /// Master switch â€” turning this off returns 503 from the earn endpoints.
  adsEnabled            Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
