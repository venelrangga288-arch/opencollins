// DGT.LZ Gateway — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum KeyStatus {
  ACTIVE
  REVOKED
  DELETED
}

enum BillingStatus {
  // MVP: metering only, no payments. TRACKED = usage recorded & costed.
  TRACKED
  UNPRICED // model had no pricing row — cost is unknown, never fabricated
}

enum RequestStatus {
  SUCCESS
  PROVIDER_ERROR
  AUTH_ERROR
  RATE_LIMITED
  QUOTA_EXCEEDED
  CLIENT_ERROR
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions     Session[]
  apiKeys      ApiKey[]
  usageQuota   UsageQuota?
  requestLogs  RequestLog[]
  usageRecords UsageRecord[]

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  name         String
  keyHash      String    @unique // HMAC-SHA256 of full key
  prefix       String // masked display prefix, e.g. dgtlz_live_ab12cd34
  status       KeyStatus @default(ACTIVE)
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])

  requestLogs  RequestLog[]
  usageRecords UsageRecord[]

  @@index([userId, status])
}

model Provider {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "openagentic", "mock"
  name      String
  baseUrl   String
  status    String   @default("active") // active | disabled | degraded
  createdAt DateTime @default(now())

  models      Model[]
  requestLogs RequestLog[]
}

model Model {
  id              String  @id @default(cuid())
  providerId      String
  providerModelId String // upstream model identifier
  displayName     String
  contextWindow   Int?
  available       Boolean @default(true)

  provider Provider       @relation(fields: [providerId], references: [id])
  pricing  ModelPricing[]

  @@unique([providerId, providerModelId])
}

model RequestLog {
  id         String        @id @default(cuid())
  requestId  String        @unique // idempotency key for usage recording
  userId     String
  apiKeyId   String?
  providerId String
  model      String
  endpoint   String
  status     RequestStatus
  httpStatus Int
  latencyMs  Int
  createdAt  DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id])
  apiKey      ApiKey?      @relation(fields: [apiKeyId], references: [id])
  provider    Provider     @relation(fields: [providerId], references: [id])
  usageRecord UsageRecord?

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

model UsageRecord {
  id            String        @id @default(cuid())
  requestId     String        @unique // FK to RequestLog.requestId — enforces idempotency
  userId        String
  apiKeyId      String?
  provider      String
  model         String
  inputTokens   Int? // null = provider did not report; never fabricated
  outputTokens  Int?
  totalTokens   Int?
  latencyMs     Int
  estimatedCost Decimal?      @db.Decimal(12, 6) // upstream cost, null when unpriced
  billingStatus BillingStatus @default(TRACKED)
  recordedAt    DateTime      @default(now())

  requestLog RequestLog @relation(fields: [requestId], references: [requestId])
  user       User       @relation(fields: [userId], references: [id])
  apiKey     ApiKey?    @relation(fields: [apiKeyId], references: [id])

  @@index([userId, recordedAt])
  @@index([model, recordedAt])
}

model ModelPricing {
  id            String    @id @default(cuid())
  modelId       String
  model         String // upstream model id (denormalized for lookup)
  providerSlug  String
  inputPer1M    Decimal   @db.Decimal(12, 6) // USD per 1M input tokens
  outputPer1M   Decimal   @db.Decimal(12, 6)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = current
  modelRef      Model     @relation(fields: [modelId], references: [id])

  @@unique([providerSlug, model, effectiveFrom])
  @@index([model, effectiveFrom])
}

model UsageQuota {
  id             String   @id @default(cuid())
  userId         String   @unique
  requestsPerDay Int      @default(1000)
  tokensPerDay   Int      @default(1000000)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // admin or user id, null for system
  action    String // e.g. "key.revoked", "user.suspended"
  target    String? // entity description
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
}
